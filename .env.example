# Copy to .env, chmod 600, fill with secrets. DO NOT commit real secrets.
RESIP_API_KEY=REPLACE_WITH_RANDOM_32PLUS_BYTES
RESIP_BILLING_HMAC_KEY=REPLACE_WITH_DIFFERENT_RANDOM_32PLUS_BYTES
MARZBAN_URL=https://marzban.example.net
MARZBAN_SUDO_USER=api_operator
MARZBAN_SUDO_PASSWORD=REPLACE_ME
# Marzban user REST omits numeric id; read it from a READ-ONLY DB connection.
# SQLite on standard Marzban install:
MARZBAN_DB_URL=sqlite:///file:/marzban-ro/db.sqlite3?mode=ro&uri=true
MARZBAN_DATA_DIR=/var/lib/marzban
# MySQL alternative: remove readonly volume in compose; use account with SELECT only
# MARZBAN_DB_URL=mysql+pymysql://readonly:password@10.0.0.5:3306/marzban
RESIP_AUTO_APPLY=false
RESIP_POLL_SECONDS=60
RESIP_PROBE_MAX_AGE=3600
RESIP_PROBE_URL=https://api.ipify.org?format=json
# The following env vars are referenced by registered exits:
PROXY_ONE_USERNAME=REPLACE_ME
PROXY_ONE_PASSWORD=REPLACE_ME
# Only for HTTP Marzban behind a truly private tunnel:
# RESIP_ALLOW_HTTP_MARZBAN=true
# Optional IPRoyal API discovery token:
# IPROYAL_API_TOKEN=REPLACE_ME

# Optional full-stack Compose TLS profile (deploy/compose.stack.yaml).
# DNS must point to this server. Restrict panel access to your management network.
PANEL_DOMAIN=panel.example.net
VPN_DOMAIN=vpn.example.net
ACME_EMAIL=operator@example.net
MARZBAN_IMAGE=gozargah/marzban:v0.8.4
RESIP_IMAGE=marzban-residentialip-plugin:0.2.0
CADDY_IMAGE=caddy:2.10.2-alpine
